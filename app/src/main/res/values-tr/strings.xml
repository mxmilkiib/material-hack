    <string name="application_info_text">
        <![CDATA[
            <b>Sürüm</b> %1$s<br>
            <b>Derleme</b> %2$d &#8226; <a href="https://github.com/mxmilkiib/material-hack/commit/%5$s">%5$s</a><br>
            <b>Derlendi</b> %3$s (%4$s)<br><br>
            <b>Material Hack</b> Ha Duy Trung tarafından Materialistic\'in bir fork\'udur.<br><br>
            <b>Değişiklikler:</b><br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Modern toolchain<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Gradle 8<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; AGP 8.5<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Kotlin 1.9<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; targetSdk 34<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Yeni temalar<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Mor<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Okyanus<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Gül<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Monokai<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Nord<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Daha küçük fontlar ve daha dar boşluklarla kompakt liste modu<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Yeni fontlar<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Hack Nerd Font<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Inter<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; JetBrains Mono<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fira Code<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Terminus<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fixedsys<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Basitleştirilmiş navigasyon menüsü, tüm bölümler kökte<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Uygulama genelinde daha dar boşluklar<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Şeffaf kaydırma parlaması<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Yan yana debug kurulumu desteği<br>
            <br>
            Fork: <a href="https://github.com/mxmilkiib/material-hack">mxmilkiib/material-hack</a><br>
            Original: <a href="https://github.com/hidroh/materialistic">hidroh/materialistic</a>
        ]]>
