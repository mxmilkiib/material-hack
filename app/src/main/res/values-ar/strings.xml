    <string name="application_info_text">
        <![CDATA[
            <b>الإصدار</b> %1$s<br>
            <b>البناء</b> %2$d &#8226; <a href="https://github.com/mxmilkiib/material-hack/commit/%5$s">%5$s</a><br>
            <b>تم البناء</b> %3$s (%4$s)<br><br>
            <b>Material Hack</b> هو فرع من Materialistic بواسطة Ha Duy Trung.<br><br>
            <b>التغييرات:</b><br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; أدوات حديثة<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Gradle 8<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; AGP 8.5<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Kotlin 1.9<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; targetSdk 34<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; سمات جديدة<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; بنفسجي<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; محيط<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; وردة<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; مونوكاي<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; نورد<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; وضع قائمة مضغوط بخطوط أصغر ومسافات أضيق<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; خطوط جديدة<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Hack Nerd Font<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Inter<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; JetBrains Mono<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fira Code<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Terminus<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fixedsys<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; درج تنقل مبسط، جميع الأقسام في الجذر<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; مسافات أضيق في جميع أنحاء التطبيق<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; توهج شفاف للتمرير<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; دعم تثبيت التصحيح جنبًا إلى جنب<br>
            <br>
            Fork: <a href="https://github.com/mxmilkiib/material-hack">mxmilkiib/material-hack</a><br>
            Original: <a href="https://github.com/hidroh/materialistic">hidroh/materialistic</a>
        ]]>
    </string>
