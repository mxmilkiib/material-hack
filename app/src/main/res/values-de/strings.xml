    <string name="application_info_text">
        <![CDATA[
            <b>Version</b> %1$s<br>
            <b>Build</b> %2$d &#8226; <a href="https://github.com/mxmilkiib/material-hack/commit/%5$s">%5$s</a><br>
            <b>Erstellt</b> %3$s (%4$s)<br><br>
            <b>Material Hack</b> ist ein Fork von Materialistic von Ha Duy Trung.<br><br>
            <b>Änderungen:</b><br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Modernisierte Toolchain<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Gradle 8<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; AGP 8.5<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Kotlin 1.9<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; targetSdk 34<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Neue Themes<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Violett<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Ozean<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Rose<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Monokai<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Nord<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Kompakter Listenmodus mit kleineren Schriftarten und engerem Abstand<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Neue Schriftarten<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Hack Nerd Font<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Inter<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; JetBrains Mono<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fira Code<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Terminus<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fixedsys<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Vereinfachte Navigationsschublade, alle Abschnitte im Stammverzeichnis<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Engerer Abstand in der gesamten App<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Transparenter Scroll-Glanz<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; Unterstützung für parallele Debug-Installation<br>
            <br>
            Fork: <a href="https://github.com/mxmilkiib/material-hack">mxmilkiib/material-hack</a><br>
            Original: <a href="https://github.com/hidroh/materialistic">hidroh/materialistic</a>
        ]]>
    </string>
