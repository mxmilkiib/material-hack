    <string name="application_info_text">
        <![CDATA[
            <b>பதிப்பு</b> %1$s<br>
            <b>உருவாக்கம்</b> %2$d &#8226; <a href="https://github.com/mxmilkiib/material-hack/commit/%5$s">%5$s</a><br>
            <b>உருவாக்கப்பட்டது</b> %3$s (%4$s)<br><br>
            <b>Material Hack</b> Ha Duy Trung இன் Materialistic இன் ஒரு பிரிவு.<br><br>
            <b>மாற்றங்கள்:</b><br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; நவீன toolchain<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Gradle 8<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; AGP 8.5<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Kotlin 1.9<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; targetSdk 34<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; புதிய தீம்கள்<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; ஊதா<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; பெருங்கடல்<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; ரோஜா<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; மோனோகாய்<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; நோர்ட்<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; சிறிய எழுத்துருக்கள் மற்றும் இறுக்கமான இடைவெளிகளுடன் காம்பாக்ட் பட்டியல் முறை<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; புதிய எழுத்துருக்கள்<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Hack Nerd Font<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Inter<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; JetBrains Mono<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fira Code<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Terminus<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fixedsys<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; எளிதாக்கப்பட்ட வழிசெலுத்தும் டிராயர், அனைத்து பிரிவுகளும் ரூட்டில்<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; முழு பயன்பாட்டிலும் இறுக்கமான இடைவெளிகள்<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; தெளிவான ஸ்க்ரோல் ஒளி<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; பக்க-பக்க டிபக் நிறுவல் ஆதரவு<br>
            <br>
            Fork: <a href="https://github.com/mxmilkiib/material-hack">mxmilkiib/material-hack</a><br>
            Original: <a href="https://github.com/hidroh/materialistic">hidroh/materialistic</a>
        ]]>
    </string>
