    <string name="application_info_text">
        <![CDATA[
            <b>সংস্করণ</b> %1$s<br>
            <b>বিল্ড</b> %2$d &#8226; <a href="https://github.com/mxmilkiib/material-hack/commit/%5$s">%5$s</a><br>
            <b>নির্মিত</b> %3$s (%4$s)<br><br>
            <b>Material Hack</b> Ha Duy Trung দ্বারা Materialistic এর একটি ফর্ক।<br><br>
            <b>পরিবর্তন:</b><br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; আধুনিক toolchain<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Gradle 8<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; AGP 8.5<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Kotlin 1.9<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; targetSdk 34<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; নতুন থিম<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; ভায়োলেট<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; মহাসাগর<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; গোলাপ<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; মনোকাই<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; নর্ড<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; ছোট ফন্ট এবং সংকীর্ণ ফাঁকের সাথে কমপ্যাক্ট তালিকা মোড<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; নতুন ফন্ট<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Hack Nerd Font<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Inter<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; JetBrains Mono<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fira Code<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Terminus<br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#8226;&nbsp; Fixedsys<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; সরল নেভিগেশন ড্রয়ার, সমস্ত বিভাগ রুটে<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; সমগ্র অ্যাপে সংকীর্ণ ফাঁক<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; স্বচ্ছ স্ক্রল চকচক<br>
            &nbsp;&nbsp;&nbsp;&#8226;&nbsp; সাইড-বাই-সাইড ডিবাগ ইনস্টলেশন সমর্থন<br>
            <br>
            Fork: <a href="https://github.com/mxmilkiib/material-hack">mxmilkiib/material-hack</a><br>
            Original: <a href="https://github.com/hidroh/materialistic">hidroh/materialistic</a>
        ]]>
    </string>
